<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Bar FAB - just the toggle button, menu is shown via PopupWindow -->
<ImageButton xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickBarToggle"
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:background="@drawable/floating_menu_button"
    android:src="@drawable/ic_quick_bar"
    android:scaleType="fitCenter"
    android:padding="4dp"
    android:alpha="0.4"
    android:elevation="9999dp"
    android:visibility="gone"
    android:contentDescription="@string/quick_bar_toggle" />
