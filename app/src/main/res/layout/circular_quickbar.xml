<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal Shortcut Bar with drag handle -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/circularQuickBarContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:background="@drawable/shortcut_bar_modern_bg"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:gravity="center"
    android:visibility="gone"
    android:alpha="0.4"
    android:elevation="9999dp">

    <!-- Up to 10 Shortcut buttons (dynamic visibility) - smaller size -->
    <ImageButton
        android:id="@+id/shortcut0"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="1dp"
        android:background="@drawable/shortcut_button_selector"
        android:scaleType="centerInside"
        android:padding="4dp"
        android:visibility="gone"
        android:contentDescription="Shortcut" />

